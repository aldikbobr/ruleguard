# Copy to .env and fill in. The .env file is never committed.
# No key is needed yet: all market data comes from public APIs.

# AI rule review: Gemini (free tier, key from aistudio.google.com) — used by scripts/ai-analyze.mjs
GEMINI_API_KEY=
# Optional: models to try in order, and the minimum gap between requests
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash-lite
# GEMINI_MIN_INTERVAL_MS=4500

# Alternative AI provider (not wired up yet)
ANTHROPIC_API_KEY=

# For production access to DFlow (Kalshi markets on Solana)
DFLOW_API_KEY=
